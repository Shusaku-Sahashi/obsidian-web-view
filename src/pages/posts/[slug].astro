---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getNoteBySlug, obsidianFileUri } from '../../lib/notes-index';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const note = getNoteBySlug(post.id);
const title = note?.displayTitle ?? post.id;
const obsidianHref = note ? obsidianFileUri(note) : undefined;
const created = post.data.created;
---

<BaseLayout title={title}>
  <article class="post">
    <header>
      <time datetime={created.toISOString()}>
        {created.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1>{title}</h1>
      <div class="header-row">
        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => <TagBadge tag={tag} />)}
          </div>
        )}
        {obsidianHref && (
          <a class="obsidian-link" href={obsidianHref}>Obsidianで開く</a>
        )}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  time {
    font-size: 0.85rem;
    color: var(--muted-color);
  }
  h1 {
    margin: 0.3rem 0 0;
    font-size: 1.7rem;
    line-height: 1.5;
  }
  .header-row {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .obsidian-link {
    font-size: 0.85rem;
    color: var(--muted-color);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    text-decoration: none;
  }
  .obsidian-link:hover {
    color: var(--link-color);
    border-color: var(--link-color);
  }
  .prose {
    margin-top: 2rem;
  }
</style>
