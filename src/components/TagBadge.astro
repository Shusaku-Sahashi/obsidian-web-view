---
interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<a class="tag-badge" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>

<style>
  .tag-badge {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--tag-bg);
    color: var(--tag-color);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .tag-badge:hover {
    background: var(--tag-bg-hover);
  }
</style>
