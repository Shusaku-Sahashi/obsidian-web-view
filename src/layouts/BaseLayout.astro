---
import '../styles/global.css';
import TagCloud from '../components/TagCloud.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-title">Obsidian Notes</a>
    </header>
    <main class="site-main">
      <div class="content-area">
        <slot />
      </div>
      <TagCloud />
    </main>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border-color);
    background: var(--header-bg);
  }
  .site-title {
    display: block;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 1.2rem 1rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
  }
  .site-main {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    display: flex;
    align-items: flex-start;
    gap: 3rem;
  }
  .content-area {
    flex: 1;
    min-width: 0;
  }
  .site-main > :global(.tag-cloud) {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 2rem;
  }
  @media (max-width: 800px) {
    .site-main {
      flex-direction: column;
    }
    .site-main > :global(.tag-cloud) {
      width: 100%;
      position: static;
    }
  }
</style>
